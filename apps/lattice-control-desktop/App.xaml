<Application x:Class="Lattice.Control.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="LatticeBackground" Color="#050A10" />
        <SolidColorBrush x:Key="LatticePanel" Color="#0A121D" />
        <SolidColorBrush x:Key="LatticeBorder" Color="#183246" />
        <SolidColorBrush x:Key="LatticeText" Color="#EAF7FF" />
        <SolidColorBrush x:Key="LatticeMuted" Color="#6E8296" />
        <SolidColorBrush x:Key="LatticeCyan" Color="#16D9FF" />
    </Application.Resources>
</Application>

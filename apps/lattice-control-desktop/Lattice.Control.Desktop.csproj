<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LATTICE</AssemblyName>
    <RootNamespace>Lattice.Control.Desktop</RootNamespace>
    <UseAppHost>true</UseAppHost>
    <Version>1.0.0-rc.1</Version>
    <Product>LATTICE Control</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PORTABLE_RELEASE_CANDIDATE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

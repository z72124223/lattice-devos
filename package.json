{
  "name": "lattice-devos",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first autonomous AI development platform.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "control:start": "node apps/lattice-control/src/server.mjs",
    "control:codex-lifecycle-acceptance": "node scripts/run-codex-app-server-lifecycle-acceptance.mjs",
    "control:primary-conversation-acceptance": "node scripts/run-primary-conversation-acceptance.mjs",
    "control:project": "node apps/lattice-control/src/project-client.mjs",
    "control:receipt": "node apps/lattice-control/src/installation-receipt-client.mjs",
    "control:decision-mcp": "node apps/lattice-control/src/decision-core-mcp.mjs",
    "control:decision-mcp-acceptance": "node scripts/run-lattice-control-decision-core-mcp-acceptance.mjs",
    "control:four-core-acceptance": "node scripts/run-four-core-product-acceptance.mjs",
    "control:four-core-automatic-acceptance": "node scripts/run-four-core-product-acceptance.mjs --automatic",
    "control:four-core-browser-acceptance": "node scripts/run-four-core-product-acceptance.mjs --serve-browser",
    "control:work-mcp": "node apps/lattice-control/src/work-core-mcp.mjs",
    "control:work-mcp-acceptance": "node scripts/run-lattice-control-work-core-mcp-acceptance.mjs",
    "control:test": "node --test \"apps/lattice-control/test/*.test.mjs\"",
    "dependency:create": "node scripts/lattice-dependency-worktree.mjs create",
    "desktop:build": "dotnet build apps/lattice-control-desktop/Lattice.Control.Desktop.csproj -c Release",
    "desktop:policy-test": "dotnet run --project apps/lattice-control-desktop-policy-tests/Lattice.Control.Desktop.PolicyTests.csproj -c Release",
    "desktop:publish": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-LatticeDesktopCandidate.ps1",
    "desktop:candidate-test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/Test-LatticeDesktopCandidate.ps1",
    "desktop:run": "dotnet run --project apps/lattice-control-desktop/Lattice.Control.Desktop.csproj -c Release -- --url http://127.0.0.1:4317/",
    "operator:start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start-lattice-full-chain.ps1",
    "operator:smoke": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start-lattice-full-chain.ps1 -Mode Smoke",
    "test": "node --test \"test/*.test.js\"",
    "test:domain": "node --test test/task-domain.test.js",
    "test:operator-entrypoint": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/test-lattice-full-chain-entrypoint.ps1",
    "verify": "npm run check && npm run control:test && npm test"
  }
}

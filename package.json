{
  "name": "lattice-devos",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first autonomous AI development platform.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "operator:start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start-lattice-full-chain.ps1",
    "operator:smoke": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/start-lattice-full-chain.ps1 -Mode Smoke",
    "test": "node --test \"test/*.test.js\"",
    "test:domain": "node --test test/task-domain.test.js",
    "test:operator-entrypoint": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/test-lattice-full-chain-entrypoint.ps1",
    "status:refresh": "node scripts/export-lattice-engineering-status.mjs",
    "status:open": "node scripts/export-lattice-engineering-status.mjs --open",
    "delivery:finish": "node scripts/finish-lattice-delivery.mjs",
    "verify": "npm run check && npm test"
  }
}
